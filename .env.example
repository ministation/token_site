# PostgreSQL база данных игры
DB_HOST=IP
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=your_password_here

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://your-server-ip:8067/callback

# Discord ID администраторов через запятую
ADMIN_ROLE_IDS=

# Discord-ники администраторов сайта (через запятую)
ADMIN_USERNAMES=dotnet_build

# Discord-ники модераторов сайта (через запятую, только обжалования)
MODERATOR_USERNAMES=

# Discord-ники контент-мейкеров (красный тэг КОНТЕНТ)
CONTENT_MAKER_USERNAMES=

# Discord-ники хранителей времени (зелёный тэг ХРАНИТЕЛЬ)
TIME_KEEPER_USERNAMES=

# Discord ID контент-мейкеров (через запятую)
CONTENT_MAKER_DISCORD_IDS=

# Discord ID хранителей времени (через запятую)
TIME_KEEPER_DISCORD_IDS=

# Бот и сервер Discord для автосинхронизации ролей
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ID Discord-ролей контент-мейкеров и хранителей времени
CONTENT_MAKER_ROLE_IDS=
TIME_KEEPER_ROLE_IDS=

# Лотерея
LOTTERY_COST=5

# Переводы
MIN_TRANSFER=1
TRANSFER_COOLDOWN=60

# Чат
MAX_CHAT_MESSAGES=100

# Сервер
SERVER_HOST=0.0.0.0
SERVER_PORT=8067

# Пути к файлам
SESSIONS_FILE=sessions.json
SOCIAL_DB_PATH=social.db
UPLOAD_DIR=static/uploads