# PostgreSQL база данных игры
DB_HOST=IP
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=your_password_here

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://your-server-ip:8067/callback

# Discord ID администраторов через запятую
ADMIN_ROLE_IDS=

# Discord-ники администраторов сайта (через запятую)
ADMIN_USERNAMES=dotnet_build

# Discord-ники модераторов сайта (через запятую, только обжалования)
MODERATOR_USERNAMES=

# Discord-ники контент-мейкеров (красный тэг КОНТЕНТ)
CONTENT_MAKER_USERNAMES=

# Discord-ники хранителей времени (зелёный тэг ХРАНИТЕЛЬ)
TIME_KEEPER_USERNAMES=

# Discord ID контент-мейкеров (через запятую)
CONTENT_MAKER_DISCORD_IDS=

# Discord ID хранителей времени (через запятую)
TIME_KEEPER_DISCORD_IDS=

# Бот и сервер Discord для автосинхронизации ролей
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ID Discord-ролей контент-мейкеров и хранителей времени
CONTENT_MAKER_ROLE_IDS=
TIME_KEEPER_ROLE_IDS=

# Лотерея
LOTTERY_COST=5

# Переводы
MIN_TRANSFER=1
TRANSFER_COOLDOWN=60

# Чат
MAX_CHAT_MESSAGES=100

# Сервер
SERVER_HOST=0.0.0.0
SERVER_PORT=8067

# Публичный URL сайта (return/callback для платежей)
SITE_PUBLIC_URL=https://ministation.ru

# SS14 Wizard Den OAuth — привязка игрового аккаунта на сайте
# Создайте приложение: https://account.spacestation14.com/Identity/Account/Manage/Developer
# Callback URL: https://ministation.ru/api/ss14/callback (отключите Require PKCE)
SS14_OAUTH_CLIENT_ID=
SS14_OAUTH_CLIENT_SECRET=
# SS14_OAUTH_REDIRECT_URI=https://ministation.ru/api/ss14/callback
# SS14_OAUTH_AUTHORITY=https://account.spacestation14.com

# Реферальная программа (монеты)
REFERRAL_REFERRER_COINS=5
REFERRAL_REFEREE_COINS=3

# SS14 статус и прямое подключение
GAME_STATUS_URL=http://ss14.ministation.ru:1214/status
GAME_CONNECT_ADDRESS=ss14://ss14.ministation.ru:1214

# Platega.io — по умолчанию ВЫКЛ (PLATEGA_ENABLED=0). Код остаётся, но не используется.
PLATEGA_ENABLED=0
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# PLATEGA_API_BASE=https://app.platega.io
# PLATEGA_DEFAULT_METHOD=2
#
# Callback (если снова включите):
#   https://ministation.ru/platega/callback
# (дубль: https://ministation.ru/api/donations/platega/callback)

# Ручной СБП — основной запасной вариант, пока Platega выключена
MANUAL_SBP_ENABLED=1

# Robokassa — запасной провайдер (если задан логин+пароли)
# ROBOKASSA_LOGIN=
# ROBOKASSA_PASSWORD1=
# ROBOKASSA_PASSWORD2=

# Пути к файлам
SESSIONS_FILE=sessions.json
SOCIAL_DB_PATH=social.db
UPLOAD_DIR=static/uploads